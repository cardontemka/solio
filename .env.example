# =============================================================================
#  Solio — environment variables (EXAMPLE FILE)
# =============================================================================
#
#  ⚠  NEVER put real values in this file. It is committed to git.
#  ⚠  Copy it to `.env.local` and fill that in instead — `.env*` is gitignored.
#
#      cp .env.example .env.local
#
#  Every variable is validated at startup by src/lib/validation/env.ts.
#  A missing or malformed value fails with a clear message naming the variable,
#  not an obscure runtime error.
#
#  PUBLIC  = prefixed NEXT_PUBLIC_, shipped in the browser bundle. Never secret.
#  SECRET  = server-only. Must NEVER appear in client code or a NEXT_PUBLIC_ var.
#
#  See docs/setup.md for step-by-step instructions on obtaining each value.
# =============================================================================


# -----------------------------------------------------------------------------
#  Supabase — auth + database
#  Where: https://supabase.com/dashboard → your project → Project Settings → API
# -----------------------------------------------------------------------------

# PUBLIC — your project's REST/Auth endpoint.
# Local dev value: http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_URL=

# PUBLIC — the publishable (anon) key. Safe in the browser; RLS is what protects
# your data, not this key. Newer projects show this as "Publishable key"
# (sb_publishable_...); older ones as "anon public" (a JWT). Either works.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# SECRET — bypasses ALL Row Level Security. Server-only.
# Used exclusively by src/lib/supabase/admin.ts behind an admin role check.
# If this leaks, every row in your database is readable and writable.
# Newer projects call this the "Secret key" (sb_secret_...); older ones
# "service_role". NEVER prefix this with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# SECRET — project reference id, used by `supabase link`. Not sensitive on its
# own but kept here so scripts can read it.
SUPABASE_PROJECT_REF=


# -----------------------------------------------------------------------------
#  Cloudflare R2 — book image storage
#  Where: https://dash.cloudflare.com → R2 → Overview / Manage R2 API Tokens
#
#  If these are left EMPTY, the app falls back to LocalDevelopmentStorage
#  (files under public/uploads). That fallback is refused in production —
#  the server will not boot. See docs/setup.md STEP 5.
# -----------------------------------------------------------------------------

# SECRET — Cloudflare account id (R2 → Overview, right-hand sidebar).
R2_ACCOUNT_ID=

# SECRET — R2 API token Access Key ID.
R2_ACCESS_KEY_ID=

# SECRET — R2 API token Secret Access Key. Shown ONCE at creation time.
R2_SECRET_ACCESS_KEY=

# SECRET — bucket name, e.g. solio-book-images
R2_BUCKET_NAME=

# PUBLIC — the public custom domain serving the bucket, e.g.
# https://images.solio.mn  (no trailing slash).
# This host must also be listed in next.config.ts images.remotePatterns.
NEXT_PUBLIC_R2_PUBLIC_URL=


# -----------------------------------------------------------------------------
#  Cloudflare Turnstile — bot protection on register / login / password reset
#  Where: https://dash.cloudflare.com → Turnstile → Add site
#
#  Leave empty to disable Turnstile in local development.
# -----------------------------------------------------------------------------

# PUBLIC — site key, rendered in the widget.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# SECRET — secret key, used server-side to verify the token.
TURNSTILE_SECRET_KEY=


# -----------------------------------------------------------------------------
#  Application
# -----------------------------------------------------------------------------

# PUBLIC — canonical site origin, used for auth redirects, sitemap, Open Graph,
# and the URL inside every printed item label.
# Local: http://localhost:3000     Production: https://solio.mn
#
# Set it on the host too (Vercel → Settings → Environment Variables), for the
# Production environment specifically. Left unset or blank there, the app falls
# back to the deployment's own domain — everything works, but canonical URLs and
# label QR codes point at the vercel.app address rather than solio.mn.
NEXT_PUBLIC_SITE_URL=http://localhost:3000


# -----------------------------------------------------------------------------
#  Browser push notifications (OPTIONAL)
#  Generate a key pair once:  npx web-push generate-vapid-keys
#
#  With these empty push is simply off — the in-app notification list and the
#  bell keep working, nothing else changes.
# -----------------------------------------------------------------------------

# The public half is sent to the browser, so it carries the NEXT_PUBLIC_ prefix.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# SECRET — signs every push. Never prefix this one.
VAPID_PRIVATE_KEY=

# Contact address push services can reach you at. mailto: or https:
VAPID_SUBJECT=mailto:hello@solio.mn


# -----------------------------------------------------------------------------
#  Error monitoring (OPTIONAL — Sentry)
#  Where: https://sentry.io → Projects → Client Keys (DSN)
#
#  If empty, errors are logged as structured JSON to the server console instead.
#  A missing DSN degrades silently; it never breaks a request.
#  beforeSend strips email, phone and any sb-* cookie before sending.
# -----------------------------------------------------------------------------

# SECRET — server-side DSN.
SENTRY_DSN=

# PUBLIC — browser DSN (separate key, restricted).
NEXT_PUBLIC_SENTRY_DSN=
